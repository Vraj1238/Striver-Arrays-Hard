//Brute
//TC :- O(N^3) + O(NlogN)  set elements insert =>(Avoid sorting bcoz only 3 elements)
//SC :- 2*O(No. of Triplets)   => Set and Answer array
vector<vector<int>> sum_3(vector<int> &arr, int n) {
    set<vector<int>> st;
    for(int i = 0; i < n; i++) {
        for(int j = i + 1; j < n; j++) {
            for(int k = j + 1; k < n; k++) {
                if(arr[i] + arr[j] + arr[k] == 0) {
                    vector<int> temp = {arr[i], arr[j], arr[k]};
                    //Remove Duplicates
                    sort(temp.begin(), temp.end());
                    //Set => Unique Elements
                    st.insert(temp);
                }
            }
        }
    }
    vector<vector<int>> ans(st.begin(), st.end());
    return ans;
}
//Better
//TC :- O(N^2 logM) 
//SC :- O(N) + 2*O(No. of Triplets)   =>Not of hashset O(N^2) =>Always reset to empty set and at the end it has n elements  
vector<vector<int>> sum_3_1(vector<int> &arr, int n) {
    set<vector<int>> st;
    for(int i = 0; i < n; i++) {
        //Create Empty Set
        set<int> hashset;
        for(int j = i + 1; j < n; j++) {
            int third = -(arr[i] + arr[j]);
            if(hashset.find(third) != hashset.end()) {
                vector<int> temp = {arr[i], arr[j], third};
                sort(temp.begin(), temp.end());
                st.insert(temp);
            }
            hashset.insert(arr[j]);
        }
    }
    vector<vector<int>> ans(st.begin(), st.end());
    return ans;
}
//Optimal
//TC :- O(N^2) + O(NlogN) 
//SC :- O(No. of Triplets)   
vector<vector<int>> sum_3_2(vector<int> &arr, int n) {
    vector<vector<int>> ans;
    //Sort
    sort(arr.begin(), arr.end());
    for(int i = 0; i < n; i++) {
        //Skip iteration if currect i element is equal to previous i element
        if(i > 0 && arr[i] == arr[i - 1])
            continue;
        int j = i + 1;
        int k = n - 1;
        while(j < k) {
            int sum = arr[i] + arr[j] + arr[k];
            if(sum < 0) {
                j++;
            }
            else if(sum > 0) {
                k--;
            }
            else {
                ans.push_back({arr[i], arr[j], arr[k]});
                j++;
                k--;
                while(j < k && arr[j] == arr[j - 1])
                    j++;

                while(j < k && arr[k] == arr[k + 1])
                    k--;
            }
        }
    }
    return ans;
}
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    vector<vector<int>> ans = sum_3_2(arr,n);
    for(int i = 0; i < ans.size(); i++) {
        for(int j = 0; j < ans[i].size(); j++) {
            cout << ans[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}

