//Brute
//TC :- O(N*N)                 SC :- O(1)  => O(2)
vector<int> majority_element_n3(vector<int> &arr,int n){
    vector<int> ans;
    for(int i=0;i<n;i++){
        if(ans.size() == 0 || ans[0] != arr[i]){    //if dont use it will keep printing same element in some cases
            int count = 0;
            for(int j=0;j<n;j++){
                if(arr[i] == arr[j]){
                    count++;
                }
            }
            if(count > n/3){
                ans.push_back(arr[i]);
            }
        }
        if(ans.size() == 2)     //if dont use it will keep printing same element in some cases
            break;
    }
    return ans;
}
//Better
//TC :- O(NlogN) / O(N)            SC :- O(N)
vector<int> majority_element_n3_1(vector<int> &arr,int n){
    unordered_map<int,int> mpp;
    vector<int> ans;
    for(int i=0;i<n;i++){
        mpp[arr[i]]++;
        if(mpp[arr[i]] > n/3){
            ans.push_back(arr[i]);
        }
    }
    return ans;
